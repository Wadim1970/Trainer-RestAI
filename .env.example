# Фронтенд (публичные значения — попадают в сборку)
VITE_SUPABASE_URL=https://<ваш-supabase>
VITE_SUPABASE_ANON_KEY=<anon key>
# Адрес API тренажёра; пусто — тот же домен (nginx отдаёт /api/ серверу тренажёра)
VITE_API_URL=

# Сервер API (только на сервере, НЕ в сборку фронтенда)
SUPABASE_URL=https://<ваш-supabase>
SUPABASE_SERVICE_KEY=<service_role key>
# Публичный адрес приложения — из него строятся ссылки/QR приглашений
TRAINER_PUBLIC_URL=https://trainer.example.com
# Откуда разрешены запросы к API (через запятую); пусто — отовсюду
TRAINER_CORS_ORIGINS=
# Тестовый режим админки: рестораны, открытые без токена. Строки нет — открыта учебная «Сыроварня».
# Строка с пустым значением закрывает ВСЕ рестораны (для боевого запуска): TRAINER_ADMIN_OPEN_RESTAURANTS=
# TRAINER_ADMIN_OPEN_RESTAURANTS=
# Общий токен администратора для остальных ресторанов (X-Admin-Token). Не отдавайте его в браузер ресторана.
ADMIN_TOKEN=
